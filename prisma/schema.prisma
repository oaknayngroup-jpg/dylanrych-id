// Dylanrych.id — Prisma schema
// Postgres (Neon / Prisma Postgres / Vercel Postgres / Supabase).
// Local: use a Postgres URL, or `npx create-db` for a temporary DB.

generator client {
  provider      = "prisma-client-js"
  // native = local/dev; rhel-openssl-3.0.x = Vercel Node serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  tagline     String?
  description String
  notesTop    String?
  notesHeart  String?
  notesBase   String?
  character   String?
  bpom        String?
  volumeMl    Int         @default(35)
  priceIdr    Int         @default(179900)
  stock       Int         @default(100)
  imageFront  String
  imageTilt   String?
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("SUPER_ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Promo {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  /// PERCENT | FIXED
  discountType  String
  discountValue Int
  minSpendIdr   Int       @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique
  /// PENDING | PAID | SHIPPED | COMPLETED | CANCELLED | FAILED
  status           String      @default("PENDING")

  customerName     String
  customerEmail    String
  customerPhone    String
  shippingAddress  String
  shippingCity     String
  shippingProvince String?
  shippingPostal   String?

  subtotalIdr      Int
  discountIdr      Int         @default(0)
  shippingIdr      Int         @default(0)
  totalIdr         Int

  promoId          String?
  promo            Promo?      @relation(fields: [promoId], references: [id])
  promoCode        String?

  /// Midtrans
  paymentProvider  String      @default("MIDTRANS")
  paymentStatus    String      @default("PENDING") // PENDING | SETTLEMENT | EXPIRE | DENY | CANCEL
  midtransOrderId  String?
  midtransSnapToken String?
  paidAt           DateTime?

  /// JNT
  shippingCourier  String      @default("JNT")
  shippingService  String?
  trackingNumber   String?
  jntBookingId     String?
  shippedAt        DateTime?

  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  productSlug  String
  unitPriceIdr Int
  quantity     Int
  lineTotalIdr Int
}
